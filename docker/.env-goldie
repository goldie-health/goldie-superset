DEV_MODE=false
FLASK_DEBUG=false
SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no
SESSION_COOKIE_SECURE=true

# --- Gunicorn workers / threads ---
# Concurrency = SERVER_WORKER_AMOUNT * SERVER_THREADS_AMOUNT.
# Sized for a single db.t4g.micro (~95 usable connections) that backs BOTH the
# Superset metadata AND the analytics queries, so the budget is shared. Math:
#   web idle held  = SERVER_WORKER_AMOUNT * SQLALCHEMY_POOL_SIZE        = 2 * 6  = 12
#   web burst peak = SERVER_WORKER_AMOUNT * (POOL_SIZE + MAX_OVERFLOW)  = 2 * 10 = 20
# On top of this: the analytics-DB pool (set in the Superset UI -> Database ->
# Advanced -> Performance to pool_size 3 / max_overflow 2), the celery worker
# (CELERYD_CONCURRENCY below) and beat. Keep the grand total well under RDS
# max_connections (verify with: SHOW max_connections;).
SERVER_WORKER_AMOUNT=2
SERVER_THREADS_AMOUNT=6
GUNICORN_TIMEOUT=120

# --- Metadata DB connection pool (consumed by superset_config.py) ---
# pool_size ~= threads per worker so threads don't queue on the pool.
SQLALCHEMY_POOL_SIZE=6
SQLALCHEMY_MAX_OVERFLOW=4
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_RECYCLE=1800

# SQL echo / per-query logging — keep OFF in prod, set true only to debug
SQLALCHEMY_ECHO=false

# --- Caching ---
# Data/chart cache TTL in seconds (1h). Offloads the shared RDS while keeping
# dashboard data reasonably fresh. Changing a filter uses a new cache key, so it
# always returns fresh data; only an unchanged view can be up to 1h old.
DATA_CACHE_TIMEOUT=3600
APP_CACHE_TIMEOUT=300

# --- Celery worker ---
# Keep concurrency low so background tasks don't add many connections to the
# shared t4g.micro. (docker-bootstrap.sh defaults to 2; set explicitly here.)
CELERYD_CONCURRENCY=2

# NOTE: GLOBAL_ASYNC_QUERIES is intentionally NOT enabled here. It needs the
# async JWT cookie to work cross-site inside the embedded iframe
# (GLOBAL_ASYNC_QUERIES_JWT_COOKIE_SAMESITE="None") and should be rolled out as
# a separate, staged change after validation. See openspec/minimal-safe-deploy.md.
