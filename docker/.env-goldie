DEV_MODE=false
FLASK_DEBUG=false
SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no
SESSION_COOKIE_SECURE=true

# --- Gunicorn workers / threads ---
# Concurrency = SERVER_WORKER_AMOUNT * SERVER_THREADS_AMOUNT.
# pool_size is PER WORKER and held open persistently, so the connection math is:
#   idle held  = SERVER_WORKER_AMOUNT * SQLALCHEMY_POOL_SIZE          = 3 * 10 = 30
#   burst peak = SERVER_WORKER_AMOUNT * (POOL_SIZE + MAX_OVERFLOW)    = 3 * 25 = 75
# Keep the burst peak (plus the celery worker/beat pools) under RDS max_connections.
SERVER_WORKER_AMOUNT=3
SERVER_THREADS_AMOUNT=10
GUNICORN_TIMEOUT=120

# --- Metadata DB connection pool (consumed by superset_config.py) ---
# pool_size ~= threads per worker so threads don't queue on the pool.
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=15
SQLALCHEMY_POOL_TIMEOUT=60
SQLALCHEMY_POOL_RECYCLE=1800

# SQL echo / per-query logging — keep OFF in prod, set true only to debug
SQLALCHEMY_ECHO=false

# --- Caching ---
# Data/chart cache TTL in seconds (24h). Raise if data refreshes less often.
DATA_CACHE_TIMEOUT=86400
APP_CACHE_TIMEOUT=300

# --- Global async queries ---
# Runs chart queries on Celery instead of web workers. Requires superset-worker.
GLOBAL_ASYNC_QUERIES=true
# Dedicated signing secret for the async JWT (falls back to SUPERSET_SECRET_KEY
# if unset). Generate with: openssl rand -base64 42
# GLOBAL_ASYNC_QUERIES_JWT_SECRET=
